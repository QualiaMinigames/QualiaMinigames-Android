# Gradle and the Android SDK
.gradle/
build/
local.properties

# The Rust crate this build compiles, materialized from crates.io. Deleting it is safe and
# is what a version change does.
app/rust/

# The keystore and its passwords never enter the repository. `keystore.properties` is what a
# local release build reads, and CI writes the same file from repository secrets.
keystore.properties
*.jks
*.keystore

